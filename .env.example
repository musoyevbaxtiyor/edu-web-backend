PORT=10000
# MONGO_URI'ni o'zingizning MongoDB manzilingiz bilan almashtiring
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/
JWT_SECRET=Sizning_juda_maxfiy_va_murakkab_kalitingiz_shu_yerda_bo'ladi_Masalan_ABC123XYZ456

# Telegram Bot Configuration
# Bot token va username ni BotFather dan oling
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here
# Development uchun
# BASE_URL=http://localhost:10000

# Production uchun (Render, Heroku va hokazo)
BASE_URL=https://your-production-domain.com

# Render'da yuklangan fayllar (submissions) saqlanishi uchun Persistent Disk kerak.
# Disk qo'shgach, mount path ni shu yerga yozing (masalan: /opt/render/project/data/uploads)
# UPLOAD_DIR=/opt/render/project/data/uploads
